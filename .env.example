# Open WebUI Starter DE – Konfiguration
# Kopieren als .env und anpassen.

# ===== Open WebUI =====

# Adresse, an die der Port gebunden wird
# 127.0.0.1 = nur auf diesem Rechner erreichbar (Vorgabe)
# 0.0.0.0   = aus dem ganzen Netz erreichbar – nur hinter Firewall/Reverse Proxy
WEBUI_BIND=127.0.0.1

# Port auf dem Host
WEBUI_PORT=3000

# Sitzungs-Schlüssel – BITTE ÄNDERN!
# Generieren mit: openssl rand -hex 32
WEBUI_SECRET_KEY=bitte-ein-langes-zufaelliges-secret-einsetzen

# Anzeigename der Oberfläche
WEBUI_NAME=KI-Assistent

# Sprache (de-DE, en-US, ...)
DEFAULT_LOCALE=de-DE

# Selbstregistrierung durch Besucher erlauben?
# false = nur Admin kann Nutzer anlegen (empfohlen)
ENABLE_SIGNUP=false

# Rolle neuer Nutzer
# pending = muss freigeschaltet werden (empfohlen)
# user = direkt aktiv
DEFAULT_USER_ROLE=pending


# ===== Ollama =====

# Wie lange bleibt ein Modell nach letzter Nutzung im RAM/VRAM?
# Format: 5m, 30m, 1h, ...
# Kurz = weniger RAM-Dauerverbrauch. Lang = schnellere Folge-Anfragen.
OLLAMA_KEEP_ALIVE=5m

# Wie viele parallele Anfragen pro Modell?
# Mit mehr VRAM kann man höher gehen (2-4).
OLLAMA_NUM_PARALLEL=1


# ===== LiteLLM (nur mit docker-compose.litellm.yml) =====

# Schlüssel für den Proxy, muss mit "sk-" beginnen.
# Generieren mit: echo "sk-$(openssl rand -hex 24)"
LITELLM_MASTER_KEY=sk-bitte-aendern
